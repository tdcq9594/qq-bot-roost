# docker compose 用的环境变量（复制成 .env 后填写）
#
#   cp .env.example .env
#   # 改 .env 里的 ROOST_WEBUI_KEY
#   docker compose up -d
#
# .env 不要提交到仓库（已在 .gitignore 之外，请自行确认）。

# 面板访问密钥：必填。
# 生成一个：openssl rand -hex 16
# 监听 0.0.0.0 却不设密钥时，框架会在启动期直接抛错退出——
# 无密钥的面板等于把「装插件 = 执行任意代码」的开关交给整个网络。
ROOST_WEBUI_KEY=

# 面板挂在反向代理后面时把这两行打开。
# 不开的话所有请求的来源地址都是代理自己，认证失败限速会退化成「全局一个桶」：
# 攻击者发 20 次错误密钥，你和所有运维一起被锁 60 秒，日志里还看不到攻击者 IP。
# 单层 Nginx 填 1；Cloudflare 之类 CDN + Nginx 填 2。
# ROOST_WEBUI_TRUST_PROXY=true
# ROOST_WEBUI_TRUST_PROXY_HOPS=1

# Webhook 模式（公网回调）才需要，且要先把端口映射打开
# ROOST_WEBHOOK_ENABLED=true
# ROOST_WEBHOOK_HOST=0.0.0.0
# ROOST_WEBHOOK_PORT=15208
# ROOST_WEBHOOK_PUBLIC_URL=https://bot.example.com

# 不把 AppSecret 写进配置文件时用这两个（优先级更高）
# QQ_BOT_APPID=
# QQ_BOT_SECRET=

ROOST_LOG_LEVEL=info
