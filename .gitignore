# 运行时配置：含 AppSecret，绝对不能入库
config/bot.json
config/bots/
# 保存配置时的自动备份（src/main.js 写到这里）。**每份都是完整配置，含明文
# AppSecret**——2026-10-28 就是因为漏了这一行，14 份备份被推到 GitHub + Gitee，
# 里面 12 份带着真密钥。删掉之后必须去平台重置 AppSecret，历史删不干净。
config/backups/
# 真机联调参数（OneBot 地址 / token / 测试群号），每台机器不同
config/live-test.json
# 旧版本的配置位置，迁移后留着也不会入库
config.json

# 运行时数据与日志（含每个机器人独立的 data/bots/<id>/ 和 logs/bots/<id>/）
data/
logs/

# 插件依赖（自动安装生成，可重建）
.venv/
**/node_modules/
**/.deps.json
**/__pycache__/
*.pyc

# 插件目录：插件从市场安装（github.com/tdcq9594/qq-bot-roost-plugins），
# 属于运行内容而不是框架代码，不入库。
# 自己写的插件想版本管理，就在 plugins/ 里单独 git init。
plugins/

# docker compose 的本地环境变量（里面有面板密钥），绝不入库。
# .env.example 是模板，要入库，所以不能用 .env* 这种通配。
.env
.env.local
.env.*.local

# 通用
*.log
*.tmp
.DS_Store
Thumbs.db

# 本机的 node 路径覆盖（start.bat 用，每台机器不同，不入库）
node-path.txt
# 便携版 node 目录。必须锚定到仓库根：写成 node/ 会连 sdk/node/ 一起吃掉
/node/

# Windows 设备名，误建出来的空文件，git 索引不了
nul

# 签名私钥：只在发版机上，永不入库（公钥内嵌在 src/trust.js，这个目录整个不要）
keys/

# 开发过程文档：自查记录、竞品调研、历史方案。**已移到仓库外**：
#   D:\WorkBuddy\_archive\2026-11-06-框架开发过程文档\
# 用户 clone 下来需要的是怎么用、怎么写插件，不是我们立项时怎么讨论的。
# 下面这些规则是护栏：万一以后有人把同名文件放回 docs/，别让它误入库。
# 对应的说明性文档（插件开发规范 / 配置参考 / 常见问题 / 架构说明…）仍然入库。
/docs/代码自查记录.md
/docs/AstrBot对照与优化清单.md
/docs/优化建议.md
/docs/功能对比.md
/docs/对标ElainaBot.md
/docs/GitHub同类项目调研.md
/docs/DSH-Aurabot适配方案.md
/docs/DSH-Aurabot适配方案-v2.md
/docs/地基三块方案.md
/docs/官方接口核查与AI工具化方案.md
/docs/事件与接口清单.md
/docs/QQ号与群号绑定方案.md
/docs/数值方案.md
/docs/真机联调记录.md
/docs/账本保留策略.md
/docs/ai-chat.md
