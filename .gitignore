# 运行时配置：含 AppSecret，绝对不能入库
config/bot.json
config/bots/
# 保存配置时的自动备份（src/main.js 写到这里）。**每份都是完整配置，含明文
# AppSecret**——2026-10-28 就是因为漏了这一行，14 份备份被推到 GitHub + Gitee，
# 里面 12 份带着真密钥。删掉之后必须去平台重置 AppSecret，历史删不干净。
config/backups/
# 真机联调参数（OneBot 地址 / token / 测试群号），每台机器不同
config/live-test.json
# 旧版本的配置位置，迁移后留着也不会入库
config.json

# 运行时数据与日志（含每个机器人独立的 data/bots/<id>/ 和 logs/bots/<id>/）
data/
logs/

# 插件依赖（自动安装生成，可重建）
.venv/
**/node_modules/
**/.deps.json
**/__pycache__/
*.pyc

# 插件目录：插件从市场安装（github.com/tdcq9594/qq-bot-roost-plugins），
# 属于运行内容而不是框架代码，不入库。
# 自己写的插件想版本管理，就在 plugins/ 里单独 git init。
plugins/

# 通用
*.log
*.tmp
.DS_Store
Thumbs.db

# 本机的 node 路径覆盖（start.bat 用，每台机器不同，不入库）
node-path.txt
# 便携版 node 目录。必须锚定到仓库根：写成 node/ 会连 sdk/node/ 一起吃掉
/node/

# Windows 设备名，误建出来的空文件，git 索引不了
nul
